# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# The scripts read these values automatically at startup (via python-dotenv).

# OpenRouter API key (https://openrouter.ai/keys) — starts with sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides (defaults live in config/settings.py):
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
